# Copy this file to `.env` in the project root and fill in the real values.

# Unified Flask app
PORT=5001

# Qwen / DashScope
# Required if you want the assistant to generate real LLM chat answers.
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_MODEL=qwen-turbo

# Baidu Qianfan news search proxy
# Optional. Only needed for the legacy news-search tools.
QIANFAN_BEARER_TOKEN=your_baidu_qianfan_bearer_token_here
