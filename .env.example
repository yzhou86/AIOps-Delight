# Copy this file to `.env` in the project root and fill in the real values.

# Unified Flask app
PORT=5005
APP_SECRET_KEY=change_me_for_production

# LLM provider
# Supported values:
# - auto: prefer Qwen when configured, otherwise fall back to OpenAI-compatible API
# - qwen
# - openai_compatible
LLM_PROVIDER=auto

# Qwen / DashScope
# Optional. Used when LLM_PROVIDER=qwen, or when auto mode finds a DashScope key.
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_MODEL=qwen-turbo

# OpenAI-compatible chat API
# Optional. Used when LLM_PROVIDER=openai_compatible, or when auto mode finds these values.
# BASE_URL can be either:
# - https://api.openai.com/v1
# - or a full chat completions endpoint such as https://your-host/v1/chat/completions
# The app also accepts the standard aliases:
# - OPENAI_API_KEY
# - OPENAI_BASE_URL
# - OPENAI_MODEL
OPENAI_COMPATIBLE_API_KEY=your_openai_compatible_api_key_here
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_MODEL=gpt-4o-mini

# Baidu Qianfan news search proxy
# Optional. Only needed for the legacy news-search tools.
QIANFAN_BEARER_TOKEN=your_baidu_qianfan_bearer_token_here
